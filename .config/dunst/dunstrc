[global]
corner_radius=10
origin = top-right
offset = 10x10

font="GeistMono Nerd Font 10"
frame_width=2
horizontal_padding=10
max_icon_size=64
padding=10
transparency = 15

[urgency_low]
    background = "#161616"
    foreground = "#F2F4F8"
    frame_color = "#242424"

[urgency_normal]
    background = "#161616"
    foreground = "#F2F4F8"
    frame_color = "#242424"

[urgency_critical]
    background = "#252525"
    foreground = "#EE5396"
    frame_color = "#EE5396"

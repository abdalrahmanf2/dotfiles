[global]
corner_radius=10
origin = top-right
offset = 10x10

font="GeistMono Nerd Font 10"
frame_width=2
horizontal_padding=10
max_icon_size=64
padding=10
transparency = 15

# TokyoNight colors for dunst
# For more configuration options see https://github.com/dunst-project/dunst/blob/master/dunstrc

[urgency_low]
    background = "#16161e"
    foreground = "#c0caf5"
    frame_color = "#292e42"

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#292e42"

[urgency_critical]
    background = "#292e42"
    foreground = "#db4b4b"
    frame_color = "#db4b4b"

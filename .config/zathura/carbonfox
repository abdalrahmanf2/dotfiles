# carbonfox color theme for Zathura
#
set notification-error-bg "#EE5396" # base08 (red)
set notification-error-fg "#F2F4F8" # base05
set notification-warning-bg "#08BDBA" # base0A (teal/orange)
set notification-warning-fg "#353535" # base02 (darker gray)
set notification-bg "#161616" # base00 (background)
set notification-fg "#F2F4F8" # base05
set completion-bg "#161616" # base00
set completion-fg "#B6B8BB" # base06 (lighter gray)
set completion-group-bg "#161616" # base00
set completion-group-fg "#B6B8BB" # base06
set completion-highlight-bg "#353535" # base02 (darker gray for highlight bg)
set completion-highlight-fg "#F2F4F8" # base05
set index-bg "#161616" # base00
set index-fg "#F2F4F8" # base05
set index-active-bg "#353535" # base02
set index-active-fg "#F2F4F8" # base05
set inputbar-bg "#161616" # base00
set inputbar-fg "#F2F4F8" # base05
set statusbar-bg "#161616" # base00
set statusbar-fg "#F2F4F8" # base05
# set highlight-color "#08BDBA" # base0A (teal/orange)
# set highlight-active-color "#25BE6A" # base0B (green)
set default-bg "#161616" # base00
set default-fg "#F2F4F8" # base05
set render-loading true
set render-loading-fg "#161616" # base00
set render-loading-bg "#F2F4F8" # base05
#
# Recolor mode settings
# <C-r> to switch modes
#
set recolor-lightcolor "#161616" # base00
set recolor-darkcolor "#F2F4F8" # base05

{
  "layer": "top",
  "height": 32,
  "spacing": 5,
  // Choose the order of the modules
  "modules-left": [
    "user",
    "hyprland/workspaces",
    "custom/spotify"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "hyprland/language",
    "tray"
  ],
  "hyprland/window": {
    "separate-outputs": false
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "hyprland/language": {
    "format": "  {}",
    "format-en": "En",
    "format-ar": "Ar",
    "keyboard-name": "by-tech-gaming-keyboard"
  },
  "user": {
    "format": "  abdlrhmn0x7e | ({work_d} days {work_H} hr ↑)",
    "interval": 60,
    "height": 23,
    "width": 23,
    "icon": true,
    "avatar": "/home/abdalrahman/dotfiles/Pictures/bored.jpg"
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": " {:%I:%M %p,  %a %d %b}"
  },
  "battery": {
    "states": {
      "warning": 40
    },
    "format": "{capacity}% {icon}",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-charging": "󰂄",
    "format-warning": "󰂃",
    "tooltip-format": "{capacity}%"
  },
  "network": {
    "format-wifi": "{ipaddr}",
    "format-ethernet": "󰱔",
    "format-disconnected": "󰱟",
    "tooltip-format": "Connected to {essid}",
    "tooltip-format-ethernet": "{ifname} ",
    "on-click": "hyprctl dispatch exec '[float]' '$TERMINAL -e nmtui'"
  },
  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    "format": "{icon}  {volume}",
    "format-muted": "shhh..",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "{volume}% volume",
    "on-click": "$HOME/.config/waybar/scripts/volume.sh --toggle",
    "on-scroll-up": "$HOME/.config/waybar/scripts/volume.sh --inc",
    "on-scroll-down": "$HOME/.config/waybar/scripts/volume.sh --dec"
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "image": {
    "path": "/home/adxthya/.config/waybar/nix.svg",
    "size": 20,
    "interval": 5,
    "on-click": "brave https://search.nixos.org/packages"
  },
  "custom/spotify": {
    "interval": 1,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/music.sh",
    "on-click": "playerctl play-pause",
    "escape": true
  }
}
// vim: ft=jsonc
